---
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from "@vercel/speed-insights/astro"
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/toyicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/toyicon.png" />
		<link rel="apple-touch-icon" href="/toyicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Jesus Cazares Portfolio</title>
	</head>
	<body>
		<slot />
		
		<Analytics />
		<SpeedInsights />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		background-image: url('/src/assets/windowsXP.jpg'); 
    	background-size: cover; 
    	background-position: center;
    	background-repeat: no-repeat;
    	background-attachment: fixed;
    
    	background-color: #008080; 

		}
</style>
