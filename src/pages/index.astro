---
import Layout from '../layouts/Layout.astro';
import Taskbar from '../components/Taskbar.astro';
import folderImage from '../assets/windowsXPFolder.png';
import ProjectContent from '../components/Projects.astro';
import FullertonFunhouse from '../components/FullertonFunhouse.astro';
import RiseAndGrind from '../components/RiseAndGrind.astro';
import OdooTesting from '../components/OdooTesting.astro';
import ContactContent from '../components/Contact.astro';
---

<Layout title="Windows XP Portfolio">
  
  <main class="desktop">
    <div class="xp-window" id="portfolio-window">
      <div class="title-bar">
        <div class="title-bar-text">
          <img id=folderImage src={folderImage.src} class="window-title-icon" alt="Folder" />
          My Portfolio
        </div>
        <div class="title-bar-controls">
          <button class="win-btn minimize" id="minimize-window-btn" aria-label="Minimize"></button>
          <button class="win-btn maximize" id="maximize-window-btn" aria-label="Maximize"></button>
          <button class="win-btn close" id="close-window-btn" aria-label="Close"></button>
        </div>
      </div>

      <div class="window-body">
        <aside class="explorer-sidebar">
          <div class="sidebar-section">
            <h3>Portfolio Places</h3>
            <ul>
              <li><button class="nav-link active" data-content="home">💼 Work Experience</button></li>
              <li><button class="nav-link" data-content="about">👤 About Me</button></li>
              <li>
                <button class="nav-link" data-content="project">📂 Projects</button>
                <ul class="submenu hidden" id="projects-submenu">
                  <li><button class="nav-link" data-content="fullerton-funhouse">Fullerton Funhouse</button></li>
                  <li><button class="nav-link" data-content="rise-and-grind">Rise and Grind</button></li>
                  <li><button class="nav-link" data-content="odoo-testing">Odoo Software Testing</button></li>
                </ul>
              </li>
              <li><button class="nav-link" data-content="contact">📞 Contact</button></li>
            </ul>
          </div>
        </aside>

        <section class="explorer-content" id="display-panel">
          <div id="content-home" class="content-section">
            <h2>Welcome to My Portfolio</h2>
            <p>Click on the sidebar folder links to explore my engineering work.</p>
          </div>
          <div id="content-about" class="content-section hidden">
            <h2>About Me</h2>
            <p>I am a computer science student building things with Astro.</p>
          </div>
          <div id="content-project" class="content-section hidden">
            <ProjectContent />
          </div>
          <div id="content-fullerton-funhouse" class="content-section hidden">
            <FullertonFunhouse />
          </div>
          <div id="content-rise-and-grind" class="content-section hidden">
            <RiseAndGrind />
          </div>
          <div id="content-odoo-testing" class="content-section hidden">
            <OdooTesting />
          </div>
          <div id="content-contact" class="content-section hidden">
            <ContactContent />
          </div>
        </section>
      </div>
    </div>
  </main>

  <Taskbar />

</Layout>

<style>
  .desktop {
    width: 100vw;
    height: calc(100vh - 30px);
    position: relative;
    padding: 40px;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .xp-window {
    width: 950px;
    height: 750px;
    background: #ece9d8;
    border: 3px solid #0054e3;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    display: flex;
    flex-direction: column;
  }

  .xp-window.maximized {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: calc(100vh - 30px);
    border-radius: 0;
    border: none;
    z-index: 5000;
  }

  .title-bar {
    background: linear-gradient(to bottom, #0058e6 0%, #3a93ff 10%, #0056e2 40%, #0042c1 100%);
    padding: 4px 6px;
    color: white;
    font-weight: bold;
    font-size: 13px;
    font-family: 'Tahoma', sans-serif;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .window-title-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    vertical-align: middle;
    image-rendering: pixelated;
  }

  .title-bar-controls {
    display: flex;
    gap: 2px;
  }

  .win-btn {
    width: 21px;
    height: 21px;
    border: 1px solid #fff;
    border-radius: 3px;
    cursor: pointer;
    box-shadow: inset 1px 1px 1px rgba(255,255,255,0.5);
  }
  .win-btn.minimize { background: #0054e3; position: relative; }
  .win-btn.minimize::before { content: ''; position: absolute; bottom: 4px; left: 4px; width: 10px; height: 3px; background: white; }
  
  .win-btn.maximize { background: #0054e3; position: relative; }
  .win-btn.maximize::before { content: ''; position: absolute; top: 4px; left: 4px; width: 11px; height: 11px; border: 2px solid white; border-top: 3px solid white; box-sizing: border-box; }

  .win-btn.close { 
    background: linear-gradient(to bottom, #e7664a 0%, #d13a1a 100%); 
    border-color: #7b1300;
    color: white;
    font-weight: bold;
    font-size: 13px;
    line-height: 16px;
  }
  .win-btn.close::before { content: '×'; display: block; text-align: center; }

  .window-body {
    flex-grow: 1;
    display: flex;
    overflow: hidden;
    background: white;
    margin: 2px;
    border: 1px solid #7f9db9;
  }

  .explorer-sidebar {
    flex: 0 0 180px;
    background: linear-gradient(to bottom, #7497cf 0%, #cbe1ff 100%);
    padding: 10px;
    border-right: 1px solid #6b8dc2;
  }

  .sidebar-section {
    background: white;
    border-radius: 4px;
    border: 1px solid #fff;
    box-shadow: 1px 1px 4px rgba(0,0,0,0.2);
    overflow: hidden;
  }

  .sidebar-section h3 {
    margin: 0;
    background: linear-gradient(to right, #225ad5 0%, #6495ed 100%);
    color: white;
    font-size: 11px;
    padding: 4px 8px;
    font-family: 'Tahoma', sans-serif;
  }

  .sidebar-section ul {
    list-style: none;
    padding: 6px;
    margin: 0;
  }

  .sidebar-section button {
    background: none;
    border: none;
    width: 100%;
    text-align: left;
    font-size: 11px;
    padding: 3px 6px;
    cursor: pointer;
    color: #002299;
  }

  .submenu {
    list-style: none;
    padding: 0 0 0 15px;
    margin: 0;
  }

  .submenu.hidden {
    display: none;
  }

  .sidebar-section button:hover {
    text-decoration: underline;
  }

  /* Highlights active links in sidebar and icons in folder view */
  .nav-link.active {
    background-color: #1660E8;
    color: white;
    text-decoration: none;
    border: 1px dotted #fff;
  }

  :global(.icon-item.nav-link.active span) {
    background-color: #1660E8;
    color: white;
    padding: 0 2px;
  }

  .explorer-content {
    flex-grow: 1;
    padding: 20px;
    overflow-y: auto;
    font-family: 'Tahoma', sans-serif;
    color: #333;
  }

  .content-section.hidden {
    display: none;
  }
</style>

<script>
  const portfolioWindow = document.getElementById('portfolio-window');
  const displayPanel = document.getElementById('display-panel');
  const navButtons = document.querySelectorAll('.nav-link');
  
  const minimizeBtn = document.getElementById('minimize-window-btn');
  const maximizeBtn = document.getElementById('maximize-window-btn');
  const closeBtn = document.getElementById('close-window-btn');

  const toggleBtn = document.getElementById('toggle-portfolio-btn');
  toggleBtn?.addEventListener('click', () => {
    if (portfolioWindow) {
      if (portfolioWindow.style.display === 'none') {
        portfolioWindow.style.display = 'flex';
        toggleBtn.classList.add('active');  
      } else {
        portfolioWindow.style.display = 'none';
        toggleBtn.classList.remove('active'); 
      }
    }
  });

  minimizeBtn?.addEventListener('click', () => {
    if (portfolioWindow) {
      portfolioWindow.style.display = 'none';
      toggleBtn?.classList.remove('active'); 
    }
  });

  closeBtn?.addEventListener('click', () => {
    if (portfolioWindow) {
      portfolioWindow.style.display = 'none';
      toggleBtn?.classList.remove('active');
    }
  });

  maximizeBtn?.addEventListener('click', () => {
    if (portfolioWindow) {
      portfolioWindow.classList.toggle('maximized');
    }
  });

  navButtons.forEach(button => {
    button.addEventListener('click', () => {
      const target = button.getAttribute('data-content');
      if (!target) return;

      // Toggle projects submenu visibility if the Projects folder is clicked
      if (target === 'project') {
        const submenu = document.getElementById('projects-submenu');
        submenu?.classList.toggle('hidden');
      }
      
      // Sync active state across ALL navigation links (sidebar and icons)
      document.querySelectorAll('.nav-link').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-content') === target);
      });

      const sections = document.querySelectorAll('.content-section');
      sections.forEach(s => s.classList.add('hidden'));
      document.getElementById(`content-${target}`)?.classList.remove('hidden');
    });
  });
</script>