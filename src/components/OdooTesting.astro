---
import seleniumEX from '../assets/seleniumEX.mp4';
import keywordEX from '../assets/keywordEX.mp4';
import pythonEX from '../assets/pythonEX.mp4';
---
<div id="ot-project-wrapper">
<div class="project-item">
  <h4>Odoo Software Testing</h4>
  <p>Engineered a multi-tiered automated testing suite for Odoo ERP, leveraging Python’s unit testing framework to validate core backend logic.</p>
  <p>Developed end-to-end UI test scripts using Selenium WebDriver, simulating complex user workflows to ensure front-end stability.</p>
  <p>Architected a keyword-driven testing framework via Robot Framework, increasing test script readability.</p>
  <a href="https://github.com/JesusCazares2/odoo_software_testing" target="_blank" rel="noopener noreferrer">GitHub Repository 🚀</a>
  <ul>
    <li>Tech: Python, JavaScript, HTML, CSS, Flask</li>
  </ul>
</div>

<div class="image-container">
  <div class="mySlides fade">
    <video 
      class="main-img" 
      autoplay 
      loop 
      muted 
      playsinline
      controls
    >
      <source src={pythonEX} type="video/mp4" />
      Your browser does not support the video tag.
    </video>
  </div>

  <div class="mySlides fade">
    <video 
      class="main-img" 
      autoplay 
      loop 
      muted 
      playsinline
      controls
    >
      <source src={seleniumEX} type="video/mp4" />
      Your browser does not support the video tag.
    </video>
  </div>

  <div class="mySlides fade">
    <video 
      class="main-img" 
      autoplay 
      loop 
      muted 
      playsinline
      controls
    >
      <source src={keywordEX} type="video/mp4" />
      Your browser does not support the video tag.
    </video>
  </div>

  <a class="next" id="otNextSlide">&#10095;</a>
  <a class="prev" id="otPrevSlide">&#10094;</a>
</div>

<br> 

<div style="text-align:center">
  <span class="dot"></span>
  <span class="dot"></span>
  <span class="dot"></span>
</div>
</div>

<style>
  .image-container {
    max-width: 500px;
    height: 300px; 
    position: relative;
    margin: auto;
    border: 1px solid #7f9db9;
    background: #000;
    overflow: hidden;
  }

  .mySlides {
    display: none;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .bg-blur {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(12px) brightness(0.6);
    transform: scale(1.1); 
  }

  .main-img {
    position: relative;
    width: 100%;
    height: 100%;
    background: black;
  }

  video.main-img {
    background: #000;
    object-fit: contain; 
    z-index: 1;
  }

  .prev, .next {
    cursor: pointer;
    position: absolute;
    top: 50%;
    width: auto;
    padding: 16px;
    margin-top: -22px;
    color: white;
    text-shadow: 0 0 5px rgba(0, 0, 0, 0.8);
    font-weight: bold;
    font-size: 18px;
    transition: 0.6s ease;
    border-radius: 0 3px 3px 0;
    user-select: none;
    z-index: 10;
  }

  .next {
    right: 0;
    border-radius: 3px 0 0 3px;
  }

  .prev:hover, .next:hover {
    background-color: rgba(0, 0, 0, 0.8);
  }

  .dot {
    cursor: pointer;
    height: 15px;
    width: 15px;
    margin: 0 2px;
    background-color: #bbb;
    border-radius: 50%;
    display: inline-block;
    transition: background-color 0.6s ease;
  }

  .dot:global(.active), .dot:hover {
    background-color: #717171;
  }

  .fade {
    animation-name: fade;
    animation-duration: 1.5s;
  }

  @keyframes fade {
    from {opacity: .4}
    to {opacity: 1}
  }
</style>

<script>
  const wrapper = document.getElementById("ot-project-wrapper");
  const slides = wrapper?.querySelectorAll(".mySlides") as NodeListOf<HTMLElement>;
  const dots = wrapper?.querySelectorAll(".dot") as NodeListOf<HTMLElement>;
  let slideIndex = 1;

  function showSlides(n) {
    if (!slides || !dots) return;
    if (n > slides.length) slideIndex = 1;
    if (n < 1) slideIndex = slides.length;

    slides.forEach(slide => (slide.style.display = "none"));
    dots.forEach(dot => dot.classList.remove("active"));

    if (slides[slideIndex - 1]) slides[slideIndex - 1].style.display = "block";
    if (dots[slideIndex - 1]) dots[slideIndex - 1].classList.add("active");
  }

  showSlides(slideIndex);

  wrapper?.querySelector("#otPrevSlide")?.addEventListener("click", () => showSlides(--slideIndex));
  wrapper?.querySelector("#otNextSlide")?.addEventListener("click", () => showSlides(++slideIndex));

  dots.forEach((dot, index) => {
    dot.addEventListener("click", () => {
      slideIndex = index + 1;
      showSlides(slideIndex);
    });
  });
</script>