---
import folderImage from '../assets/windowsXPFolder.png';
---
<div class="project-container">
  <h2>Projects</h2>
  <p>Select a project to view details:</p>
  
  <div class="folder-grid">
    <button class="icon-item nav-link" data-content="fullerton-funhouse">
      <img src={folderImage.src} alt="Folder" />
      <span>Fullerton Funhouse</span>
    </button>

    <button class="icon-item nav-link" data-content="rise-and-grind">
      <img src={folderImage.src} alt="Folder" />
      <span>Rise and Grind</span>
    </button>

    <button class="icon-item nav-link" data-content="odoo-testing">
      <img src={folderImage.src} alt="Folder" />
      <span>Odoo Software Testing</span>
    </button>
  </div>
</div>

<style>
  .project-container {
    width: 100%;
  }

  .folder-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 15px;
    padding: 20px 0;
    width: 100%;
    justify-content: flex-start;
  }

  .icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 110px;
    background: none;
    border: 1px solid transparent;
    cursor: pointer;
    padding: 8px 4px;
    transition: all 0.1s;
    vertical-align: top;
  }

  .icon-item img {
    width: 48px !important;
    height: 48px !important;
    margin-bottom: 4px;
    display: block;
  }

  .icon-item span {
    font-size: 12px;
    text-align: center;
    color: #000;
    width: 100%;
    word-wrap: break-word;
  }
</style>