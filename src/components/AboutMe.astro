---
import folderImage from '../assets/windowsXPFolder.png';
---
<div class="aboutMe-container">  
  <h2>About Me</h2>
  <p>Select a folder to view details:</p>
  <div class="folder-grid">
    <button class="icon-item nav-link" data-content="about-me-writeup">
      <img src={folderImage.src} alt="Folder" />
      <span>About Me</span>
    </button>

    <a href="/Jesus_Cazares_Resume_Software_Engineer.pdf" target="_blank" rel="noopener noreferrer" class="icon-item">
      <img src={folderImage.src} alt="Folder" />
      <span>Resume</span>
    </a>

  </div>
</div>

<style>
  .aboutMe-container {
    width: 100%;
  }

  .folder-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 15px;
    padding: 20px 0;
    width: 100%;
    justify-content: flex-start;
  }

  .icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 110px;
    background: none;
    border: 1px solid transparent;
    cursor: pointer;
    padding: 8px 4px;
    transition: all 0.1s;
    vertical-align: top;
  }

  .icon-item img {
    width: 48px !important;
    height: 48px !important;
    margin-bottom: 4px;
    display: block;
  }

  .icon-item span {
    font-size: 12px;
    text-align: center;
    color: #000;
    width: 100%;
    word-wrap: break-word;
    text-decoration: none;
  }
</style>