---
import homeScreen from '../assets/homeScreenFF.png';
import brickBreaker from '../assets/bb.png';
import blackJack from '../assets/bj.png';
import ZMaze from '../assets/zMaze.png';
import flappyBird from '../assets/FB.png';
import slotMachine from '../assets/SM.png';
import spaceShooter from '../assets/spaceShooter.png';
---
<div class="project-item">
  <h4>Fullerton Funhouse</h4>
  <p>Architected a full-stack web platform featuring 6 interactive titles, utilizing Python (Flask) and JavaScript to manage game states and dynamic frontend interactivity.</p>
  <p>Implemented a unified UI/UX framework with responsive CSS and HTML5, ensuring 100% platform parity across desktop browsers.</p>
  <p>Optimized asset loading and site navigation by building a centralized interface, reducing page load latency.</p>
  <a href="https://fullertonfunhouse.onrender.com/" target="_blank" rel="noopener noreferrer">Launch Live Demo 🚀</a>
  <ul>
    <li>Tech: Python, JavaScript, HTML, CSS, Flask</li>
  </ul>
</div>

<div class="image-container">
  <div class="mySlides fade">
    <img class="bg-blur" src={homeScreen.src} aria-hidden="true" />
    <img class="main-img" src={homeScreen.src} alt="Fullerton Funhouse Home Screen" />
  </div>

  <div class="mySlides fade">
    <img class="bg-blur" src={brickBreaker.src} aria-hidden="true" />
    <img class="main-img" src={brickBreaker.src} alt="Brick Breaker Game" />
  </div>

  <div class="mySlides fade">
    <img class="bg-blur" src={blackJack.src} aria-hidden="true" />
    <img class="main-img" src={blackJack.src} alt="Black Jack Game" />
  </div>

  <div class="mySlides fade">
    <img class="bg-blur" src={ZMaze.src} aria-hidden="true" />
    <img class="main-img" src={ZMaze.src} alt="Z Maze Game" />
  </div>

  <div class="mySlides fade">
    <img class="bg-blur" src={flappyBird.src} aria-hidden="true" />
    <img class="main-img" src={flappyBird.src} alt="Flappy Bird Game" />
  </div>

  <div class="mySlides fade">
    <img class="bg-blur" src={slotMachine.src} aria-hidden="true" />
    <img class="main-img" src={slotMachine.src} alt="Slot Machine Game" />
  </div>

  <div class="mySlides fade">
    <img class="bg-blur" src={spaceShooter.src} aria-hidden="true" />
    <img class="main-img" src={spaceShooter.src} alt="Space Shooter Game" />
  </div>

  <a class="prev" id="prevSlide">&#10094;</a>
  <a class="next" id="nextSlide">&#10095;</a>
</div>

<br> 

<div style="text-align:center">
  <span class="dot"></span>
  <span class="dot"></span>
  <span class="dot"></span>
  <span class="dot"></span>
  <span class="dot"></span>
  <span class="dot"></span>
  <span class="dot"></span>
</div>

<style>
  .image-container {
    max-width: 500px;
    height: 300px; /* Fixed height to prevent window scrolling */
    position: relative;
    margin: auto;
    border: 1px solid #7f9db9;
    background: #000;
    overflow: hidden;
  }

  .mySlides {
    display: none;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .bg-blur {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(12px) brightness(0.6);
    transform: scale(1.1); /* Prevents white edges from blur */
  }

  .main-img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain; /* Keeps aspect ratio without stretching */
    z-index: 1;
  }

  .prev, .next {
    cursor: pointer;
    position: absolute;
    top: 50%;
    width: auto;
    padding: 16px;
    margin-top: -22px;
    color: white;
    text-shadow: 0 0 5px rgba(0, 0, 0, 0.8);
    font-weight: bold;
    font-size: 18px;
    transition: 0.6s ease;
    border-radius: 0 3px 3px 0;
    user-select: none;
    z-index: 10;
  }

  .next {
    right: 0;
    border-radius: 3px 0 0 3px;
  }

  .prev:hover, .next:hover {
    background-color: rgba(0, 0, 0, 0.8);
  }

  .dot {
    cursor: pointer;
    height: 15px;
    width: 15px;
    margin: 0 2px;
    background-color: #bbb;
    border-radius: 50%;
    display: inline-block;
    transition: background-color 0.6s ease;
  }

  .dot:global(.active), .dot:hover {
    background-color: #717171;
  }

  .fade {
    animation-name: fade;
    animation-duration: 1.5s;
  }

  @keyframes fade {
    from {opacity: .4}
    to {opacity: 1}
  }
</style>

<script>
  let slideIndex = 1;
  const slides = document.querySelectorAll(".mySlides") as NodeListOf<HTMLElement>;
  const dots = document.querySelectorAll(".dot") as NodeListOf<HTMLElement>;

  function showSlides(n) {
    if (n > slides.length) slideIndex = 1;
    if (n < 1) slideIndex = slides.length;

    slides.forEach(slide => (slide.style.display = "none"));
    dots.forEach(dot => dot.classList.remove("active"));

    if (slides[slideIndex - 1]) slides[slideIndex - 1].style.display = "block";
    if (dots[slideIndex - 1]) dots[slideIndex - 1].classList.add("active");
  }

  showSlides(slideIndex);

  document.getElementById("prevSlide")?.addEventListener("click", () => showSlides(--slideIndex));
  document.getElementById("nextSlide")?.addEventListener("click", () => showSlides(++slideIndex));

  dots.forEach((dot, index) => {
    dot.addEventListener("click", () => {
      slideIndex = index + 1;
      showSlides(slideIndex);
    });
  });
</script>
