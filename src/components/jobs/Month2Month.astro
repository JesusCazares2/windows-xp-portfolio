---
import pointCloud from '../../assets/pointCloud.png';
import rgb_d from '../../assets/rgb_d.png';
import activeGrip from '../../assets/activeGrip.png';
---
<div id="mm-project-wrapper">
<div class="work-item">
    <h2>Month2Month</h2>
    <p>
        Engineered a real-time predictive control system using Radial Basis Function Interpolation to map 2D pixel coordinates directly to joint angles
    </p>
    <p>
        Implemented a demonstration-based learning workflow by training the RBF model on 50 manual physical examples to learn spatial mappings directly from the environment.
    </p>
    <p>
        Developed a high-speed Python manipulation loop that predicts and executes grasp sequences, synchronizing a RealSense D435i depth stream with the D1 Arm via DDS.
    </p>

    <p>Tech Stack</p>
    <ul>
        <li>Core Languages: Python, C++</li>
        <li>Frameworks & SDKs: ROS2 (Humble), Unitree SDK2</li>
        <li>Computer Vision / Input: OpenCV</li>
        <li>Hardware: Unitree Go2, Unitree D1, Intel RealSense D435i, Unitree Go2 Controllers, Customer Camera Mount</li>
    </ul>
</div>

<div class="image-container">
  <div class="mySlides fade">
    <img class="bg-blur" src={pointCloud.src} aria-hidden="true" />
    <img class="main-img" src={pointCloud.src} alt="3D Point Cloud Image" />
  </div>

  <div class="mySlides fade">
    <img class="bg-blur" src={rgb_d.src} aria-hidden="true" />
    <img class="main-img" src={rgb_d.src} alt="RGB-D Image" />
  </div>

  <div class="mySlides fade">
    <img class="bg-blur" src={activeGrip.src} aria-hidden="true" />
    <img class="main-img" src={activeGrip.src} alt="Robot Grippng Item" />
  </div>

  <a class="next" id="mmNextSlide">&#10095;</a>
  <a class="prev" id="mmPrevSlide">&#10094;</a>
</div>

<br> 

<div style="text-align:center">
  <span class="dot"></span>
  <span class="dot"></span>
  <span class="dot"></span>
</div>
</div>

<style>
    .work-item ul {
    list-style-type: none;
    padding-left: 5px;
    margin-top: 10px;
  }
  .work-item li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 10px;
    line-height: 1.5;
    font-size: 15px;
  }

  .work-item li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    width: 8px;
    height: 8px;
    background: linear-gradient(135deg, #0058e6 0%, #3a93ff 100%);
    border: 1px solid #003399;
    box-shadow: 1px 1px 1px rgba(0,0,0,0.2);
  }

  .image-container {
    max-width: 400px;
    height: 300px;  
    position: relative;
    margin: auto;
    border: 1px solid #000;
    overflow: hidden;
  }

  .mySlides {
    display: none;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .bg-blur {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(12px) brightness(0.6);
    transform: scale(1.1); 
  }

  .main-img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain; 
    z-index: 1;
  }

  .prev, .next {
    cursor: pointer;
    position: absolute;
    top: 50%;
    width: auto;
    padding: 16px;
    margin-top: -22px;
    color: white;
    text-shadow: 0 0 5px rgba(0, 0, 0, 0.8);
    font-weight: bold;
    font-size: 18px;
    transition: 0.6s ease;
    border-radius: 0 3px 3px 0;
    user-select: none;
    z-index: 10;
  }

  .next {
    right: 0;
    border-radius: 3px 0 0 3px;
  }

  .prev:hover, .next:hover {
    background-color: rgba(0, 0, 0, 0.8);
  }

  .dot {
    cursor: pointer;
    height: 15px;
    width: 15px;
    margin: 0 2px;
    background-color: #bbb;
    border-radius: 50%;
    display: inline-block;
    transition: background-color 0.6s ease;
  }

  .dot:global(.active), .dot:hover {
    background-color: #717171;
  }

  .fade {
    animation-name: fade;
    animation-duration: 1.5s;
  }

  @keyframes fade {
    from {opacity: .4}
    to {opacity: 1}
  }
</style>

<script>
  const wrapper = document.getElementById("mm-project-wrapper");
  const slides = wrapper?.querySelectorAll(".mySlides") as NodeListOf<HTMLElement>;
  const dots = wrapper?.querySelectorAll(".dot") as NodeListOf<HTMLElement>;
  let slideIndex = 1;

  function showSlides(n) {
    if (!slides || !dots) return;
    if (n > slides.length) slideIndex = 1;
    if (n < 1) slideIndex = slides.length;

    slides.forEach(slide => (slide.style.display = "none"));
    dots.forEach(dot => dot.classList.remove("active"));

    if (slides[slideIndex - 1]) slides[slideIndex - 1].style.display = "block";
    if (dots[slideIndex - 1]) dots[slideIndex - 1].classList.add("active");
  }

  showSlides(slideIndex);

  wrapper?.querySelector("#mmPrevSlide")?.addEventListener("click", () => showSlides(--slideIndex));
  wrapper?.querySelector("#mmNextSlide")?.addEventListener("click", () => showSlides(++slideIndex));

  dots.forEach((dot, index) => {
    dot.addEventListener("click", () => {
      slideIndex = index + 1;
      showSlides(slideIndex);
    });
  });