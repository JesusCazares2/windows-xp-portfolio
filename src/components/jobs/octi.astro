---
import Film from '../../assets/octi-images/film.jpg';
import CR from '../../assets/octi-images/cr.jpg';
import Enclosure from '../../assets/octi-images/enclosure.jpg';
import Digital from '../../assets/octi-images/digital.jpg';
---
<div id="octi-project-wrapper">
<div class="work-item">
    <div class="work-header">
        <div class="title-section">
            <h2 class="company">Orange Coast Testing, Inc.</h2>
            <h3 class="role">RT Technician & Information Technology Specialist</h3>
        </div>
        <div class="meta-section">
            <span class="dates">January 2022 - October 2022</span>
            <span class="location">Santa Ana, CA</span>
        </div>
    </div>
    <p>
        Operated industrial X-ray and gamma-ray imaging systems to inspect critical aerospace and defense components, 
        analyzing structural integrity to catch internal defects before parts went into production.
    </p>
    <p>
        Doubled as the facility's IT support, resolving 95% of technical tickets independently with same-day solutions 
        to keep operations running smoothly and minimize staff downtime.
    </p>
    <p>
        Cleaned up and reorganized the company’s shared network drives, implementing a standardized folder structure and 
        setting up weekly automated backups to ensure data retention.
    </p>

    <p>Skills & Tools:</p>
    <ul>
        <li>NDT Systems: Industrial X-Rays, Gamma Rays, Digital X-Ray, Radiographic Interpretation</li>
        <li>IT Systems: Active Directory, Windows Server Admin, Ticket System</li>
        <li>Data: Shared Drives, Automated Backups, Folder Architecture</li>
    </ul>
</div>

<div class="image-container">
  <div class="mySlides fade">
    <img class="bg-blur" src={Film.src} aria-hidden="true" />
    <img class="main-img" src={Film.src} alt="XRay Film" />
  </div>

  <div class="mySlides fade">
    <img class="bg-blur" src={Digital.src} aria-hidden="true" />
    <img class="main-img" src={Digital.src} alt="Digital XRay" />
  </div>

  <div class="mySlides fade">
    <img class="bg-blur" src={Enclosure.src} aria-hidden="true" />
    <img class="main-img" src={Enclosure.src} alt="XRay Enclosure" />
  </div>

  <div class="mySlides fade">
    <img class="bg-blur" src={CR.src} aria-hidden="true" />
    <img class="main-img" src={CR.src} alt="XRay CR Machine" />
  </div>

  <a class="next" id="octiNextSlide">&#10095;</a>
  <a class="prev" id="octiPrevSlide">&#10094;</a>
</div>

<br> 

<div style="text-align:center">
  <span class="dot"></span>
  <span class="dot"></span>
  <span class="dot"></span>
  <span class="dot"></span>
</div>
</div>

<style>
  .work-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid #0054e3; 
    padding-bottom: 8px;
    margin-bottom: 15px;
  }

  .company {
    margin: 0;
    font-size: 20px;
    color: #003399;
  }

  .role {
    margin: 2px 0 0 0;
    font-size: 15px;
    color: #333;
    font-weight: bold;
  }

  .meta-section {
    text-align: right;
    display: flex;
    flex-direction: column;
    font-size: 13px;
    font-family: 'Tahoma', sans-serif;
  }

  .dates {
    font-weight: bold;
  }

  .location {
    color: #666;
    font-style: italic;
  }

    .work-item ul {
    list-style-type: none;
    padding-left: 5px;
    margin-top: 10px;
  }
  .work-item li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 10px;
    line-height: 1.5;
    font-size: 15px;
  }

  .work-item li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    width: 8px;
    height: 8px;
    background: linear-gradient(135deg, #0058e6 0%, #3a93ff 100%);
    border: 1px solid #003399;
    box-shadow: 1px 1px 1px rgba(0,0,0,0.2);
  }

  .image-container {
    max-width: 400px;
    height: 300px;  
    position: relative;
    margin: auto;
    border: 1px solid #000;
    overflow: hidden;
  }

  .mySlides {
    display: none;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .bg-blur {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(12px) brightness(0.6);
    transform: scale(1.1); 
  }

  .main-img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain; 
    z-index: 1;
  }

  .prev, .next {
    cursor: pointer;
    position: absolute;
    top: 50%;
    width: auto;
    padding: 16px;
    margin-top: -22px;
    color: white;
    text-shadow: 0 0 5px rgba(0, 0, 0, 0.8);
    font-weight: bold;
    font-size: 18px;
    transition: 0.6s ease;
    border-radius: 0 3px 3px 0;
    user-select: none;
    z-index: 10;
  }

  .next {
    right: 0;
    border-radius: 3px 0 0 3px;
  }

  .prev:hover, .next:hover {
    background-color: rgba(0, 0, 0, 0.8);
  }

  .dot {
    cursor: pointer;
    height: 15px;
    width: 15px;
    margin: 0 2px;
    background-color: #bbb;
    border-radius: 50%;
    display: inline-block;
    transition: background-color 0.6s ease;
  }

  .dot:global(.active), .dot:hover {
    background-color: #717171;
  }

  .fade {
    animation-name: fade;
    animation-duration: 1.5s;
  }

  @keyframes fade {
    from {opacity: .4}
    to {opacity: 1}
  }
</style>

<script>
  const wrapper = document.getElementById("octi-project-wrapper");
  const slides = wrapper?.querySelectorAll(".mySlides") as NodeListOf<HTMLElement>;
  const dots = wrapper?.querySelectorAll(".dot") as NodeListOf<HTMLElement>;
  let slideIndex = 1;

  function showSlides(n) {
    if (!slides || !dots) return;
    if (n > slides.length) slideIndex = 1;
    if (n < 1) slideIndex = slides.length;

    slides.forEach(slide => (slide.style.display = "none"));
    dots.forEach(dot => dot.classList.remove("active"));

    if (slides[slideIndex - 1]) slides[slideIndex - 1].style.display = "block";
    if (dots[slideIndex - 1]) dots[slideIndex - 1].classList.add("active");
  }

  showSlides(slideIndex);

  wrapper?.querySelector("#octiPrevSlide")?.addEventListener("click", () => showSlides(--slideIndex));
  wrapper?.querySelector("#octiNextSlide")?.addEventListener("click", () => showSlides(++slideIndex));

  dots.forEach((dot, index) => {
    dot.addEventListener("click", () => {
      slideIndex = index + 1;
      showSlides(slideIndex);
    });
  });