---
import PHS from '../../assets/iusd-images/phs.png';
import School from '../../assets/iusd-images/school.jpg';
---
<div id="iusd-project-wrapper">
<div class="work-item">
    <div class="work-header">
        <div class="title-section">
            <h2 class="company">Irvine Unified School District</h2>
            <h3 class="role">High School Custodian</h3>
        </div>
        <div class="meta-section">
            <span class="dates">October 2024 - Present</span>
            <span class="location">Irvine, CA</span>
        </div>
    </div>
    <p>
        Managed and maintained 20% of Portola High School, making sure classrooms and facilities were completely clean, safe, and ready for students and staff every day.
    </p>
    <p>
        Coordinated directly with staff and event organizers to set up scheduled activities and quickly took care of any facility issues that popped up on the fly.
    </p>
    <p>
        Handled daily tasks independently with strong time management and attention to detail, ensuring school operations ran smoothly without needing constant supervision.
    </p>

    <p>Skills:</p>
    <ul>
        <li>Operations & Safety: Facilities Maintenance, Chemical Safety, Equipment Operation</li>
        <li>Workplace Efficiency: Time Management, Problem Solving, Multitasking, Collaboration</li>
    </ul>
</div>

<div class="image-container">
  <div class="mySlides fade">
    <img class="bg-blur" src={PHS.src} aria-hidden="true" />
    <img class="main-img" src={PHS.src} alt="Portola High School" />
  </div>

  <div class="mySlides fade">
    <img class="bg-blur" src={School.src} aria-hidden="true" />
    <img class="main-img" src={School.src} alt="Aerial image of campus" />
  </div>

  <a class="next" id="iusdNextSlide">&#10095;</a>
  <a class="prev" id="iusdPrevSlide">&#10094;</a>
</div>

<br> 

<div style="text-align:center">
  <span class="dot"></span>
  <span class="dot"></span>
</div>
</div>

<style>
  .work-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid #0054e3; 
    padding-bottom: 8px;
    margin-bottom: 15px;
  }

  .company {
    margin: 0;
    font-size: 20px;
    color: #003399;
  }

  .role {
    margin: 2px 0 0 0;
    font-size: 15px;
    color: #333;
    font-weight: bold;
  }

  .meta-section {
    text-align: right;
    display: flex;
    flex-direction: column;
    font-size: 13px;
    font-family: 'Tahoma', sans-serif;
  }

  .dates {
    font-weight: bold;
  }

  .location {
    color: #666;
    font-style: italic;
  }

    .work-item ul {
    list-style-type: none;
    padding-left: 5px;
    margin-top: 10px;
  }
  
  .work-item li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 10px;
    line-height: 1.5;
    font-size: 15px;
  }

  .work-item li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    width: 8px;
    height: 8px;
    background: linear-gradient(135deg, #0058e6 0%, #3a93ff 100%);
    border: 1px solid #003399;
    box-shadow: 1px 1px 1px rgba(0,0,0,0.2);
  }

  .image-container {
    max-width: 400px;
    height: 300px;  
    position: relative;
    margin: auto;
    border: 1px solid #000;
    overflow: hidden;
  }

  .mySlides {
    display: none;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .bg-blur {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(12px) brightness(0.6);
    transform: scale(1.1); 
  }

  .main-img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: contain; 
    z-index: 1;
  }

  .prev, .next {
    cursor: pointer;
    position: absolute;
    top: 50%;
    width: auto;
    padding: 16px;
    margin-top: -22px;
    color: white;
    text-shadow: 0 0 5px rgba(0, 0, 0, 0.8);
    font-weight: bold;
    font-size: 18px;
    transition: 0.6s ease;
    border-radius: 0 3px 3px 0;
    user-select: none;
    z-index: 10;
  }

  .next {
    right: 0;
    border-radius: 3px 0 0 3px;
  }

  .prev:hover, .next:hover {
    background-color: rgba(0, 0, 0, 0.8);
  }

  .dot {
    cursor: pointer;
    height: 15px;
    width: 15px;
    margin: 0 2px;
    background-color: #bbb;
    border-radius: 50%;
    display: inline-block;
    transition: background-color 0.6s ease;
  }

  .dot:global(.active), .dot:hover {
    background-color: #717171;
  }

  .fade {
    animation-name: fade;
    animation-duration: 1.5s;
  }

  @keyframes fade {
    from {opacity: .4}
    to {opacity: 1}
  }
</style>

<script>
  const wrapper = document.getElementById("iusd-project-wrapper");
  const slides = wrapper?.querySelectorAll(".mySlides") as NodeListOf<HTMLElement>;
  const dots = wrapper?.querySelectorAll(".dot") as NodeListOf<HTMLElement>;
  let slideIndex = 1;

  function showSlides(n) {
    if (!slides || !dots) return;
    if (n > slides.length) slideIndex = 1;
    if (n < 1) slideIndex = slides.length;

    slides.forEach(slide => (slide.style.display = "none"));
    dots.forEach(dot => dot.classList.remove("active"));

    if (slides[slideIndex - 1]) slides[slideIndex - 1].style.display = "block";
    if (dots[slideIndex - 1]) dots[slideIndex - 1].classList.add("active");
  }

  showSlides(slideIndex);

  wrapper?.querySelector("#iusdPrevSlide")?.addEventListener("click", () => showSlides(--slideIndex));
  wrapper?.querySelector("#iusdNextSlide")?.addEventListener("click", () => showSlides(++slideIndex));

  dots.forEach((dot, index) => {
    dot.addEventListener("click", () => {
      slideIndex = index + 1;
      showSlides(slideIndex);
    });
  });